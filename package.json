{
  "name": "vividscales-videos",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "studio": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render src/index.ts VividScales out/vividscales.mp4 --codec=h264 --concurrency=2",
    "still": "remotion still src/index.ts VividScales out/poster.png --frame=75",
    "new:composition": "node scripts/new-composition.mjs"
  },
  "dependencies": {
    "remotion": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/media": "4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/node": "24.10.1"
  }
}
